generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String      @id @default(cuid())
  name                String
  address             String?
  tel                 String?
  email               String?
  contactName         String?
  corporateNumber     String?
  bankName            String?
  bankBranch          String?
  bankAccountType     String?
  bankAccountNumber   String?
  bankAccountHolder   String?
  bankAccountMemo     String?
  officeRent          Decimal     @default(0) @db.Decimal(14, 0)
  officeRentStartDate DateTime?
  annualGrossProfitTarget Decimal @default(0) @db.Decimal(14, 0)
  type                CompanyType @default(CLIENT)
  isActive            Boolean     @default(true)
  createdByCompanyId  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  users            User[]
  invoices         Invoice[]        @relation("InvoiceRecipient")
  issuedInvoices   Invoice[]        @relation("InvoiceIssuer")
  companyInvites   CompanyInvite[]
  userMonthlyExpenses UserMonthlyExpense[]
}

enum CompanyType {
  ADMIN
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true)
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  commissionMode CommissionMode @default(STANDARD)
  targetGrossProfitShare Decimal @default(0) @db.Decimal(5, 2)
  targetCommissionAmount Decimal @default(0) @db.Decimal(14, 0)
  employmentStartDate DateTime?
  defaultBaseSalary Decimal @default(0) @db.Decimal(14, 0)
  defaultSocialInsurance Decimal @default(0) @db.Decimal(14, 0)
  defaultEmployeeSocialInsurance Decimal @default(0) @db.Decimal(14, 0)
  defaultWithholdingTax Decimal @default(0) @db.Decimal(14, 0)
  defaultTravelExpense Decimal @default(0) @db.Decimal(14, 0)
  defaultCommunicationCost Decimal @default(0) @db.Decimal(14, 0)
  defaultWelfareExpense Decimal @default(0) @db.Decimal(14, 0)
  defaultSuppliesExpense Decimal @default(0) @db.Decimal(14, 0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company              Company          @relation(fields: [companyId], references: [id])
  clearedPayments      InvoicePayment[] @relation("ClearedBy")
  ocrJobs              OcrJob[]
  assignedInvoices     Invoice[]        @relation("InvoiceAssignedUser")
  invoiceAssignments   InvoiceAssignment[]
  assignedRcvInvoices  ReceivedInvoice[] @relation("ReceivedInvoiceAssignedUser")
  monthlyExpenses      UserMonthlyExpense[]
}

enum UserRole {
  ADMIN
  CLIENT
}

enum CommissionMode {
  STANDARD
  FIXED
  TRIAL_20
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  companyId        String
  issuerCompanyId  String?
  assignedUserId   String?
  subject          String
  issueDate        DateTime
  dueDate          DateTime
  amount           Decimal       @db.Decimal(14, 0)
  subtotal         Decimal       @db.Decimal(14, 0)
  tax              Decimal       @db.Decimal(14, 0)
  status           InvoiceStatus @default(DRAFT)
  pdfUrl           String?
  notes            String?
  source           String?
  sourceId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company        Company          @relation("InvoiceRecipient", fields: [companyId], references: [id])
  issuerCompany  Company?         @relation("InvoiceIssuer", fields: [issuerCompanyId], references: [id])
  assignedUser   User?            @relation("InvoiceAssignedUser", fields: [assignedUserId], references: [id])
  profit         InvoiceProfit?
  payments       InvoicePayment[]
  assignments    InvoiceAssignment[]
  ocrJobs        OcrJob[]
  images         InvoiceImage[]
  projectExpenses ProjectExpense[]
}

model InvoiceAssignment {
  id        String   @id @default(cuid())
  invoiceId String
  userId    String
  shareRate Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([invoiceId, userId])
  @@index([userId])
}

model InvoiceImage {
  id        String   @id @default(cuid())
  invoiceId String
  url       String
  createdAt DateTime @default(now())
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PENDING
  OVERDUE
  PAYMENT_CONFIRMED
  CLEARED
}

model InvoiceProfit {
  id          String   @id @default(cuid())
  invoiceId   String   @unique
  sales       Decimal  @db.Decimal(14, 0)
  cost        Decimal  @db.Decimal(14, 0)
  grossProfit Decimal  @db.Decimal(14, 0)
  profitRate  Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model ProjectExpense {
  id        String   @id @default(cuid())
  companyId String
  invoiceId String
  label     String
  amount    Decimal  @db.Decimal(14, 0)
  taxRate   Decimal  @default(10) @db.Decimal(5, 2)
  expenseDate DateTime?
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
}

model CommissionPayout {
  id                         String   @id @default(cuid())
  companyId                  String
  userId                     String
  yearMonth                  String
  fiscalYearStartMonth       String
  closingDate                DateTime
  paymentDate                DateTime
  cumulativeGrossProfit      Decimal  @db.Decimal(14, 0)
  commissionRate             Decimal  @db.Decimal(5, 2)
  cumulativeCommissionAmount Decimal  @db.Decimal(14, 0)
  priorPaidAmount            Decimal  @db.Decimal(14, 0)
  payoutAmount               Decimal  @db.Decimal(14, 0)
  createdByUserId            String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([userId, yearMonth])
  @@index([companyId, yearMonth])
  @@index([companyId, fiscalYearStartMonth])
}

model UserMonthlyExpense {
  id                 String   @id @default(cuid())
  companyId          String
  userId             String
  yearMonth          String
  baseSalary         Decimal  @default(0) @db.Decimal(14, 0)
  socialInsurance    Decimal  @default(0) @db.Decimal(14, 0)
  employeeSocialInsurance Decimal @default(0) @db.Decimal(14, 0)
  withholdingTax     Decimal  @default(0) @db.Decimal(14, 0)
  rentAllocation     Decimal  @default(0) @db.Decimal(14, 0)
  paidCommission     Decimal  @default(0) @db.Decimal(14, 0)
  travelExpense      Decimal  @default(0) @db.Decimal(14, 0)
  corporateTax       Decimal  @default(0) @db.Decimal(14, 0)
  communicationCost  Decimal  @default(0) @db.Decimal(14, 0)
  welfareExpense     Decimal  @default(0) @db.Decimal(14, 0)
  suppliesExpense    Decimal  @default(0) @db.Decimal(14, 0)
  otherExpense       Decimal  @default(0) @db.Decimal(14, 0)
  otherMemo          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, yearMonth])
  @@index([companyId, yearMonth])
}

model InvoicePayment {
  id              String        @id @default(cuid())
  invoiceId       String        @unique
  paymentDate     DateTime?
  paymentAmount   Decimal?      @db.Decimal(14, 0)
  paymentStatus   PaymentStatus @default(UNPAID)
  clearedAt       DateTime?
  clearedByUserId String?
  clearStatus     ClearStatus   @default(UNCLEARED)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  clearedBy User?   @relation("ClearedBy", fields: [clearedByUserId], references: [id])
}

enum PaymentStatus {
  UNPAID
  CONFIRMED
}

enum ClearStatus {
  UNCLEARED
  CLEARED
}

model ReceivedInvoice {
  id               String                @id @default(cuid())
  invoiceNumber    String?
  vendorName       String
  subject          String
  issueDate        DateTime
  dueDate          DateTime
  amount           Decimal               @db.Decimal(14, 0)
  status           ReceivedInvoiceStatus @default(UNPAID)
  paidAt           DateTime?
  notes            String?
  invoiceId        String?
  assignedUserId   String?
  ownerCompanyId   String?
  source           String?
  sourceId         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  assignedUser User? @relation("ReceivedInvoiceAssignedUser", fields: [assignedUserId], references: [id])
}

enum ReceivedInvoiceStatus {
  UNPAID
  PAID
}

model CompanyInvite {
  id        String    @id @default(cuid())
  companyId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id])
}

model CompanyLink {
  id                   String   @id @default(cuid())
  companyAId           String
  companyBId           String
  status               String   @default("PENDING")
  requestedByCompanyId String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model OcrJob {
  id              String    @id @default(cuid())
  invoiceId       String?
  originalFileUrl String
  extractedJson   Json?
  confidenceJson  Json?
  status          OcrStatus @default(PENDING)
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  createdBy User     @relation(fields: [createdByUserId], references: [id])
}

enum OcrStatus {
  PENDING
  PROCESSING
  REVIEW
  COMPLETED
  FAILED
}
